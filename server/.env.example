# Recovery Agent Backend - Environment Variables
# Copy this to .env and fill in your actual values

# Server Configuration
PORT=3000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Prompt Management
# v1 = Direct, action-focused prompts
# v2 = Empathetic, supportive framing
PROMPT_VERSION=v1

# Supabase Configuration (Authentication & User Management)
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# Opik Configuration (Tracing & Evaluation)
# Get these from: https://www.comet.com/site/products/opik/
OPIK_API_KEY=your_opik_api_key
OPIK_BASE_URL=https://app.comet.com
OPIK_PROJECT_NAME=DayZero

# Development
NODE_ENV=development
