# Recovery Agent Backend - Environment Variables
# Copy this to .env and fill in your actual values

# Server Configuration
PORT=3001

# LLM Configuration (OpenAI-compatible)
LLM_API_KEY="your llm api key here"
LLM_BASE_URL=your llm base url here
LLM_MODEL=your llm model here

# Prompt Management
PROMPT_VERSION=v1

# Opik Configuration (Tracing & Evaluation)
OPIK_API_KEY="your opik api key here"
OPIK_BASE_URL=your opik base url here
OPIK_PROJECT_NAME=Recovery Agent

# Development
NODE_ENV=development
